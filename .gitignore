# Generated plots are local information, not versioned benchmark artifacts.
/plots/
/data/**/*.png
/data/**/*.svg
/data/**/*.pdf
# Phase 5.2.4 measurements and fixtures remain local experiment artifacts.
/data/phase5_2_independent_spacing/
# Phase 5.2.5 raw channels, measurements, plots and validation logs stay local.
/data/phase5_2_csi_aging/

# Portable R1 payloads stay local; their trusted catalog is versioned.
/experiments/r1/*
!/experiments/r1/catalog.json

# R3 storage measurements remain local; retain their trusted artifact catalog.
/experiments/r3/*
!/experiments/r3/catalog.json
