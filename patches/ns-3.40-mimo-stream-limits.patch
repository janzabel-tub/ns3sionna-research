+/// Expose the station-pointer overload for the stream-capability regression test.
+class StreamCapabilityWifiManager : public ConstantRateWifiManager
+{
+  public:
+    using WifiRemoteStationManager::GetNumberOfSupportedStreams;
+};
+
+/**
+ * Check both stream-capability lookups, including HE peers whose NSS exceeds
+ * the four streams represented by their legacy HT capabilities.
+ */
+class WifiStreamCapabilitiesTest : public TestCase
+{
+  public:
+    WifiStreamCapabilitiesTest()
+        : TestCase("HE stream capabilities and HT and legacy fallbacks")
+    {
+    }
+
+  private:
+    void CheckStreams(Ptr<StreamCapabilityWifiManager> manager,
+                      Mac48Address address,
+                      uint8_t expected)
+    {
+        NS_TEST_EXPECT_MSG_EQ(manager->GetNumberOfSupportedStreams(address),
+                              expected,
+                              "Incorrect stream count from address lookup for NSS " << +expected);
+
+        WifiRemoteStationState state{};
+        state.m_htCapabilities = manager->GetStationHtCapabilities(address);
+        state.m_vhtCapabilities = manager->GetStationVhtCapabilities(address);
+        state.m_heCapabilities = manager->GetStationHeCapabilities(address);
+        WifiRemoteStation station;
+        station.m_state = &state;
+        NS_TEST_EXPECT_MSG_EQ(manager->GetNumberOfSupportedStreams(&station),
+                              expected,
+                              "Incorrect stream count from station lookup for NSS " << +expected);
+    }
+
+    void DoRun() override
+    {
+        YansWifiPhyHelper phy;
+        phy.SetChannel(YansWifiChannelHelper::Default().Create());
+        WifiHelper wifi;
+        wifi.SetStandard(WIFI_STANDARD_80211ax);
+        wifi.SetRemoteStationManager("ns3::ConstantRateWifiManager");
+        WifiMacHelper mac;
+        mac.SetType("ns3::AdhocWifiMac");
+        auto devices = wifi.Install(phy, mac, CreateObject<Node>());
+        auto device = DynamicCast<WifiNetDevice>(devices.Get(0));
+        auto manager = CreateObject<StreamCapabilityWifiManager>();
+        manager->SetupPhy(device->GetPhy());
+        manager->SetupMac(device->GetMac());
+
+        CheckStreams(manager, Mac48Address::Allocate(), 1);
+        VhtCapabilities vht;
+        for (uint8_t nss = 1; nss <= 8; ++nss)
+        {
+            vht.SetRxMcsMap(9, nss);
+        }
+        auto vhtAddress = Mac48Address::Allocate();
+        manager->AddStationVhtCapabilities(vhtAddress, vht);
+        CheckStreams(manager, vhtAddress, 1);
+
+        for (uint8_t nss = 1; nss <= 4; ++nss)
+        {
+            HtCapabilities ht;
+            for (uint8_t mcs = 0; mcs < 8 * nss; ++mcs)
+            {
+                ht.SetRxMcsBitmask(mcs);
+            }
+            auto address = Mac48Address::Allocate();
+            manager->AddStationHtCapabilities(address, ht);
+            CheckStreams(manager, address, nss);
+            manager->AddStationVhtCapabilities(address, vht);
+            CheckStreams(manager, address, nss);
+        }
+
+        HtCapabilities ht;
+        for (uint8_t mcs = 0; mcs < 32; ++mcs)
+        {
+            ht.SetRxMcsBitmask(mcs);
+        }
+        for (uint8_t nss = 1; nss <= 8; ++nss)
+        {
+            HeCapabilities he;
+            he.SetHighestNssSupported(nss);
+
+            // HE-only peers must not fall back to a single stream.
+            auto address = Mac48Address::Allocate();
+            manager->AddStationHeCapabilities(address, he);
+            CheckStreams(manager, address, nss);
+
+            // HE must take precedence over HT, even when its NSS is lower.
+            manager->AddStationHtCapabilities(address, ht);
+            CheckStreams(manager, address, nss);
+            manager->AddStationVhtCapabilities(address, vht);
+            CheckStreams(manager, address, nss);
+        }
+        manager->Dispose();
+        Simulator::Destroy();
+    }
+};
+
+/// Focused suite so stream-capability regressions can be run independently.
+class WifiStreamCapabilitiesTestSuite : public TestSuite
+{
+  public:
+    WifiStreamCapabilitiesTestSuite()
+        : TestSuite("wifi-stream-capabilities", UNIT)
+    {
+        AddTestCase(new WifiStreamCapabilitiesTest, TestCase::QUICK);
+    }
+};
+
+static WifiStreamCapabilitiesTestSuite g_wifiStreamCapabilitiesTestSuite;
